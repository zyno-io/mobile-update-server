{
    "compilerOptions": {
        "strict": true,
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "nodenext",
        "target": "ESNext",
        "module": "NodeNext",
        "esModuleInterop": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "types": [
            "node"
        ],
        "plugins": [
            {
                "transform": "./node_modules/@zyno-io/ts-server-foundation/dist/src/type-compiler/index.cjs"
            }
        ]
    },
    "include": [
        "src/**/*"
    ],
    "reflection": true
}
