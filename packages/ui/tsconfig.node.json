{
    "extends": "@tsconfig/node22/tsconfig.json",
    "include": [
        "vite.config.*",
        "postcss.config.*"
    ],
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "node"
        ],
        "plugins": [
            {
                "transform": "./node_modules/@zyno-io/ts-server-foundation/dist/src/type-compiler/index.cjs"
            }
        ]
    },
    "reflection": true
}
