{
    "name": "@zyno-io/mobile-update-server-ui",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "rimraf node_modules/.vite && vite",
        "build": "run-p typecheck build-only",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
        "build-only": "vite build",
        "format": "npx oxlint --fix --fix-suggestions --fix-dangerously && oxfmt",
        "test:e2e": "playwright test",
        "test:e2e:update": "rimraf screenshots && playwright test"
    },
    "dependencies": {
        "@fontsource/inter": "^5.2.8",
        "@fortawesome/fontawesome-free": "^7.3.0",
        "@zyno-io/openapi-client-codegen": "^2.9.0",
        "@zyno-io/vue-foundation": "^4.34.0",
        "date-fns": "^4.4.0",
        "lodash": "^4.18.1",
        "openapi-typescript-codegen": "^0.31.0",
        "pinia": "^3.0.4",
        "vue": "^3.5.39",
        "vue-router": "^5.1.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4.3.2",
        "@tsconfig/node22": "^22.0.5",
        "@types/lodash": "^4.17.24",
        "@types/node": "^26.1.1",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/tsconfig": "^0.9.1",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.17",
        "rimraf": "^6.1.3",
        "sass": "^1.101.0",
        "tailwindcss": "~4",
        "typescript": "~6",
        "vite": "^8.1.4",
        "vite-plugin-oxlint": "^2.1.2",
        "vue-tsc": "^3.3.7"
    }
}
