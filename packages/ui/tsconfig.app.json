{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "src/**/*",
        "src/**/*.vue"
    ],
    "compilerOptions": {
        "composite": true,
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "noErrorTruncation": true,
        "plugins": [
            {
                "transform": "./node_modules/@zyno-io/ts-server-foundation/dist/src/type-compiler/index.cjs"
            }
        ]
    },
    "reflection": true
}
